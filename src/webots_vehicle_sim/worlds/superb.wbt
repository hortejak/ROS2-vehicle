WorldInfo {
  title "Vehicle Simulation"
  basicTimeStep 16
  coordinateSystem "NUE"
}

Viewpoint {
  orientation 0 1 0 1.5708
  position 0 8 20
  follow "Skoda Superb Mk1"
  followType "Tracking Shot"
}

Background {
  skyColor [
    0.4 0.7 1.0
    0.4 0.7 1.0
    0.4 0.7 1.0
    0.4 0.7 1.0
    0.4 0.7 1.0
    0.4 0.7 1.0
  ]
}

DirectionalLight {
  ambientIntensity 1
  direction 0.1 -1 -0.5
  intensity 1
}

RectangleArena {
  floorSize 500 500
  floorTileSize 500 500
  floorAppearance Asphalt {}
  wallHeight 0.1
}

StraightRoadSegment {
  translation 0 0 0
  name "main_road"
  width 8
  numberOfLanes 2
  numberOfForwardLanes 1
  lines [
    RoadLine {
      color 0.85 0.85 0.0
      type "continuous"
      width 0.15
    }
  ]
  length 200
  roadBoundingObject FALSE
}

DEF superb Robot {
  translation 0 0.2377 0
  rotation 0 1 0 0
